# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.

# CMS login (/admin). All three are required; without them the CMS login stays locked.
CMS_USERNAME=
CMS_PASSWORD=
# 32+ random characters, e.g. the output of: openssl rand -base64 48
CMS_SESSION_SECRET=

# CMS storage on Vercel. Created automatically when you connect a Vercel Blob store to the project
# (Vercel → Storage → Create → Blob). Leave empty locally to store data in /data on disk.
BLOB_READ_WRITE_TOKEN=

# Contact form webhook (Zapier, Make, a CRM…). Optional while /contact is hidden.
CONTACT_WEBHOOK_URL=
