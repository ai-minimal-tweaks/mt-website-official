# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.

# CMS login (/admin). All three are required; without them the CMS login stays locked.
CMS_USERNAME=
CMS_PASSWORD=
# 32+ random characters, e.g. the output of: openssl rand -base64 48
CMS_SESSION_SECRET=

# CMS storage on Vercel. Added automatically when a Blob store is connected to the project:
# project → Storage → Create Storage → Blob → Public access → tick "Add a read-write token env var to this connection".
# BLOB_STORE_ID (OIDC) is enough for saving; BLOB_READ_WRITE_TOKEN is also needed for uploads from the CMS.
# Leave both empty locally to store data in /data on disk.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Enquiry emails ("Start a project" and "Request our deck" forms) via Resend (https://resend.com).
# 1. In Resend, add and verify the minimaltweaks.com domain (DNS records), then create an API key ("Sending access").
# 2. Add RESEND_API_KEY in Vercel. CONTACT_FROM must use the verified domain.
# CONTACT_TO is optional: comma-separated recipients, default anshul@minimaltweaks.com, shubham@minimaltweaks.com.
RESEND_API_KEY=
CONTACT_FROM=Minimal Tweaks Website <website@minimaltweaks.com>
CONTACT_TO=

# Optional extra copy of every lead to a webhook (Zapier, Make, a CRM…) as JSON.
CONTACT_WEBHOOK_URL=
